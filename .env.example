# ==============================================================================
# Wedding System Environment Configuration (.env.example)
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL 16+)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL database.
# In production on Vercel/Neon/Supabase/Railway, use pooler URL with ?pgbouncer=true or SSL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedding_system?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security
# ------------------------------------------------------------------------------
# Secret key used to encrypt httpOnly session cookies via iron-session.
# Must be at least 32 characters long.
SESSION_SECRET="change-this-to-a-very-secure-random-string-at-least-32-chars-long"

# ------------------------------------------------------------------------------
# 3. Application & Platform Domains
# ------------------------------------------------------------------------------
# Root URL for administrative access and fallback link generation.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Platform apex domain used for wedding subdomains ({slug}.weddings.test).
# In production, set to your platform domain (e.g., ourweddings.com).
PLATFORM_DOMAIN="weddings.test"

# ------------------------------------------------------------------------------
# 4. Message Queue & Cron Processing
# ------------------------------------------------------------------------------
# Shared secret for triggering scheduled queue processing (/api/cron/tick).
# Vercel Cron automatically includes this secret as Bearer token if configured.
CRON_SECRET="change-this-to-a-secure-cron-secret-token"

# Default rolling 24-hour daily send limit per wedding (Cloud API).
# Defaults to 250 if not specified.
DAILY_SEND_CAP="250"

# ------------------------------------------------------------------------------
# 5. WhatsApp Cloud API (Meta Graph API)
# ------------------------------------------------------------------------------
# Required only when using activeProvider="cloud_api" in production.
# Meta App Access Token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=""

# WhatsApp Business Account (WABA) Phone Number ID from Meta App Dashboard.
WHATSAPP_PHONE_NUMBER_ID=""

# Webhook verification token configured in Meta App Webhook settings.
WHATSAPP_VERIFY_TOKEN=""

# Meta App Secret used to verify x-hub-signature-256 HMAC on inbound webhooks.
WHATSAPP_APP_SECRET=""

# ------------------------------------------------------------------------------
# 6. Vercel Custom Domains API (Optional)
# ------------------------------------------------------------------------------
# Optional: Required only for automated custom domain registration via Vercel API.
# If omitted, system runs domain management in mock simulation mode.
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
