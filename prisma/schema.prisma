// Prisma Schema for Wedding Invitation System
// PostgreSQL Engine (multi-wedding multi-tenancy & multi-user RBAC)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Roles (RBAC)
// ---------------------------------------------------------------------------

enum GlobalRole {
  OWNER
  MANAGER
  USER
}

enum WeddingRole {
  MANAGER
  VIEWER
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String?     // null if invited but hasn't set password yet
  globalRole   GlobalRole  @default(USER)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  weddingAccess WeddingAccess[]
  invitesSent   UserInvite[]    @relation("InvitedBy")
  auditLogs     AuditLog[]
}

model WeddingAccess {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  wedding   Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId String
  role      WeddingRole @default(VIEWER)
  createdAt DateTime    @default(now())

  @@unique([userId, weddingId])
  @@index([userId])
  @@index([weddingId])
}

model UserInvite {
  id          String       @id @default(cuid())
  email       String
  token       String       @unique
  invitedBy   User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedById String
  targetRole  GlobalRole   @default(USER)
  weddingId   String?
  weddingRole WeddingRole? @default(VIEWER)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([token])
  @@index([email])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  wedding   Wedding? @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  weddingId String?
  action    String
  details   String?  // JSON string
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([weddingId])
  @@index([userId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Wedding (Tenant)
// ---------------------------------------------------------------------------

model Wedding {
  id          String   @id @default(cuid())
  slug        String   @unique
  coupleName1 String
  coupleName2 String
  weddingDate DateTime
  accentColor String   @default("#111111")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  weddingAccess    WeddingAccess[]
  events           Event[]
  accessLevels     AccessLevel[]
  guests           Guest[]
  messageLogs      MessageLog[]
  messageTemplates MessageTemplate[]
  reminders        Reminder[]
  settings         Setting[]
  auditLogs        AuditLog[]
}

// ---------------------------------------------------------------------------
// Events & Access Levels
// ---------------------------------------------------------------------------

model Event {
  id          String   @id @default(cuid())
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId   String
  name        String
  date        DateTime
  startTime   String
  venue       String
  address     String
  mapUrl      String   @default("")
  dressCode   String   @default("")
  description String   @default("")
  sortOrder   Int      @default(0)

  accessLevels AccessLevelEvent[]

  @@index([weddingId])
}

model AccessLevel {
  id        String   @id @default(cuid())
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId String
  name      String

  events AccessLevelEvent[]
  guests Guest[]

  @@unique([weddingId, name])
  @@index([weddingId])
}

model AccessLevelEvent {
  accessLevel   AccessLevel @relation(fields: [accessLevelId], references: [id], onDelete: Cascade)
  accessLevelId String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String

  @@id([accessLevelId, eventId])
}

// ---------------------------------------------------------------------------
// Guests (Scoped per wedding; token is globally unique)
// ---------------------------------------------------------------------------

model Guest {
  id            String       @id @default(cuid())
  wedding       Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId     String
  name          String
  phone         String       // E.164 format, unique per wedding
  city          String       @default("")
  pax           Int          @default(1)
  accessLevel   AccessLevel? @relation(fields: [accessLevelId], references: [id], onDelete: SetNull)
  accessLevelId String?
  token         String       @unique // 10-char URL-safe random string (globally unique)
  code          String       // 4-digit numeric string (unique per wedding)
  inviteStatus  InviteStatus @default(not_invited)
  optedOut      Boolean      @default(false)
  viewedAt      DateTime?
  lastInboundAt DateTime?
  createdAt     DateTime     @default(now())

  messageLogs MessageLog[]

  @@unique([weddingId, phone])
  @@unique([weddingId, code])
  @@index([weddingId])
}

enum InviteStatus {
  not_invited
  queued
  sent
  delivered
  read
  failed
  skipped
}

// ---------------------------------------------------------------------------
// Message Templates (Scoped per wedding)
// ---------------------------------------------------------------------------

model MessageTemplate {
  id             String   @id @default(cuid())
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId      String
  key            String   // unique per wedding
  category       String   // Marketing | Utility | Authentication
  body           String
  buttons        String   // JSON string
  sampleValues   String   // JSON string
  approvalStatus String   @default("local") // local | pending | approved | rejected
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([weddingId, key])
  @@index([weddingId])
}

// ---------------------------------------------------------------------------
// Message Logs / Job Queue (Scoped per wedding)
// ---------------------------------------------------------------------------

model MessageLog {
  id                String           @id @default(cuid())
  wedding           Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId         String
  guest             Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId           String
  kind              MessageKind
  templateKey       String           @default("")
  reminder          Reminder?        @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  reminderId        String?
  provider          String           @default("")
  status            MessageLogStatus @default(queued)
  externalMessageId String?
  errorMessage      String?
  attempts          Int              @default(0)
  nextAttemptAt     DateTime?
  scheduledAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?

  @@unique([weddingId, guestId, templateKey, kind, reminderId])
  @@index([weddingId])
  @@index([status, nextAttemptAt])
}

enum MessageKind {
  template
  text
  inbound
}

enum MessageLogStatus {
  queued
  sending
  sent
  delivered
  read
  failed
  skipped
}

// ---------------------------------------------------------------------------
// Reminders (Scoped per wedding)
// ---------------------------------------------------------------------------

model Reminder {
  id             String         @id @default(cuid())
  wedding        Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId      String
  title          String
  templateKey    String
  audienceFilter String         // JSON
  variableMap    String         // JSON
  scheduledAt    DateTime?
  status         ReminderStatus @default(draft)
  createdAt      DateTime       @default(now())

  messageLogs MessageLog[]

  @@index([weddingId])
}

enum ReminderStatus {
  draft
  scheduled
  running
  done
  cancelled
}

// ---------------------------------------------------------------------------
// Settings (Key-Value scoped per wedding)
// ---------------------------------------------------------------------------

model Setting {
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  weddingId String
  key       String
  value     String

  @@id([weddingId, key])
  @@index([weddingId])
}

// ---------------------------------------------------------------------------
// Rate Limiting (Global security table)
// ---------------------------------------------------------------------------

model RateLimit {
  id          String   @id @default(cuid())
  key         String   // e.g. "code_entry:slug:ip" or "admin_login:ip"
  action      String   // e.g. "code_entry" | "admin_login"
  attempts    Int      @default(1)
  windowStart DateTime
  expiresAt   DateTime

  @@unique([key, action])
  @@index([expiresAt])
}
